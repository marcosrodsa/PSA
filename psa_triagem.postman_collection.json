    {
      "name": "04 - Enterprise AI: B2B Contratar Palestrante (GPT-4o-mini)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code deve ser 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Deve classificar como B2B_CONTRATAR_PALESTRANTE\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.metadata.intencao).to.eql(\"B2B_CONTRATAR_PALESTRANTE\");",
              "    pm.expect(jsonData.metadata.confianca).to.be.above(0.7);",
              "});",
              "",
              "pm.test(\"Deve conter resposta empática com identidade PSA e motor OpenAI\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.resposta).to.be.a(\"string\");",
              "    pm.expect(jsonData.resposta.length).to.be.above(20);",
              "    pm.expect(jsonData.metadata.motor).to.eql(\"openai/gpt-4o-mini\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
